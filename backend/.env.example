# MySQL 数据库配置（可选）
# 三项全部填写时使用 MySQL；任一项缺失时自动使用本地 SQLite（./stock-assistant.db）
MYSQL_HOST=your_mysql_host
MYSQL_USERNAME=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=stock_assistant

# 收盘暗盘资金 LLM 查询（硅基流动 Qwen/Qwen3.5-4B）
# 在 https://cloud.siliconflow.cn/account/ak 创建 API Key
SILICONFLOW_API_KEY=your_siliconflow_api_key
