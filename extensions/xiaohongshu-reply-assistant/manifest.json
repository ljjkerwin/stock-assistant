{
  "manifest_version": 3,
  "name": "小红书暗盘回复助手",
  "description": "在小红书通知页回复框中生成可编辑的收盘明暗盘资金文案。",
  "version": "0.1.0",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.xiaohongshu.com/*",
    "https://stock.vdata.top/*",
    "http://localhost:3100/*",
    "http://127.0.0.1:3100/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "小红书暗盘回复助手",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "options.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.xiaohongshu.com/notification*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
